er: var(--font-header-en);\n  --jahiz-font-ui: var(--font-en);\n  --jahiz-font-arabic: var(--font-ar);\n  --jahiz-font-stats: var(--font-en);\n  --jahiz-wght-black: 900;\n  --jahiz-wght-extrabold: 800;\n  --jahiz-wght-bold: 700;\n  --jahiz-wght-semibold: 600;\n  --jahiz-wght-medium: 500;\n  --jahiz-wght-regular: 400;\n  --jahiz-tracking-display: -0.025em;\n  --jahiz-tracking-header: -0.015em;\n  --jahiz-tracking-ui: 0.01em;\n  --jahiz-tracking-label: 0.15em;\n  --jahiz-lh-tight: 1.1;\n  --jahiz-lh-standard: 1.25;\n  --jahiz-lh-body: 1.5;\n  --ion-font-family: var(--jahiz-font-ui);\n  --direction-start: left;\n  --direction-end: right;\n  --jahiz-rtl-flip: 1;\n}\n[_ngcontent-ng-c272329211]:root[dir=rtl] {\n  --jahiz-font-display: var(--font-ar);\n  --jahiz-font-header: var(--font-ar);\n  --jahiz-font-ui: var(--font-ar);\n  --jahiz-tracking-display: 0;\n  --jahiz-tracking-header: 0;\n  --jahiz-tracking-ui: 0;\n  --jahiz-tracking-label: 0;\n  --jahiz-lh-tight: 1.35;\n  --jahiz-lh-standard: 1.5;\n  --jahiz-lh-body: 1.6;\n  --direction-start: right;\n  --direction-end: left;\n  --jahiz-rtl-flip: -1;\n}\n[_ngcontent-ng-c272329211]:root {\n  --void: #080808;\n  --pitch: #111111;\n  --obsidian: #191919;\n  --iron: #222222;\n  --glass: rgba(17, 17, 17, 0.80);\n  --jahiz-surface-input: #141414;\n  --jahiz-surface-base: var(--pitch);\n  --brand: #3388EE;\n  --brand-dim: rgba(51, 136, 238, 0.12);\n  --brand-glow: rgba(51, 136, 238, 0.35);\n  --brand-deep: #1A5FBB;\n  --victory: #2ECC71;\n  --victory-dim: rgba(46, 204, 113, 0.12);\n  --victory-glow: rgba(46, 204, 113, 0.30);\n  --aka: #E74C3C;\n  --aka-dim: rgba(231, 76, 60, 0.12);\n  --aka-glow: rgba(231, 76, 60, 0.30);\n  --accent-strike: var(--aka);\n  --accent-strike-faint: rgba(231, 76, 60, 0.06);\n  --accent-strike-edge: rgba(231, 76, 60, 0.18);\n  --yuko: #F39C12;\n  --yuko-dim: rgba(243, 156, 18, 0.12);\n  --yuko-glow: rgba(243, 156, 18, 0.30);\n  --accent-penalty: #FFD000;\n  --accent-penalty-dim: rgba(255, 208, 0, 0.12);\n  --accent-penalty-glow: rgba(255, 208, 0, 0.30);\n  --t1: #F0F0F0;\n  --t2: #888888;\n  --t3: rgba(255, 255, 255, 0.25);\n  --b0: rgba(255, 255, 255, 0.04);\n  --b1: rgba(255, 255, 255, 0.06);\n  --b2: rgba(255, 255, 255, 0.10);\n  --ba: rgba(51, 136, 238, 0.35);\n  --g-crown:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(51, 136, 238, 0.28) 0%,\n      transparent 65%);\n  --g-steel:\n    linear-gradient(\n      135deg,\n      #3388EE 0%,\n      #1A5FBB 100%);\n  --g-shine:\n    linear-gradient(\n      135deg,\n      rgba(255, 255, 255, 0.04) 0%,\n      transparent 60%);\n  --g-aka:\n    radial-gradient(\n      ellipse at 0% 100%,\n      rgba(231, 76, 60, 0.45) 0%,\n      transparent 70%);\n  --g-ao:\n    radial-gradient(\n      ellipse at 100% 100%,\n      rgba(51, 136, 238, 0.45) 0%,\n      transparent 70%);\n  --g-fusion:\n    radial-gradient(\n      ellipse at 92% 100%,\n      rgba(231, 76, 60, 0.18) 0%,\n      transparent 52%),\n    radial-gradient(\n      ellipse at 8% 0%,\n      rgba(51, 136, 238, 0.32) 0%,\n      transparent 60%),\n    linear-gradient(\n      145deg,\n      var(--obsidian) 0%,\n      var(--pitch) 100%);\n  --g-strike-edge:\n    linear-gradient(\n      135deg,\n      #3388EE 0%,\n      #1A5FBB 88%,\n      rgba(231, 76, 60, 0.35) 100%);\n  --g-energy-rim:\n    radial-gradient(\n      ellipse at 100% 50%,\n      rgba(231, 76, 60, 0.15) 0%,\n      transparent 58%);\n  --gradient-feature-signature:\n    radial-gradient(\n      ellipse at 100% 50%,\n      color-mix(in srgb, var(--accent-strike) 14%, transparent) 0%,\n      transparent 48%),\n    radial-gradient(\n      ellipse at 4% 0%,\n      color-mix(in srgb, var(--brand) 42%, transparent) 0%,\n      transparent 58%),\n    linear-gradient(\n      120deg,\n      color-mix(in srgb, var(--brand) 24%, transparent) 0%,\n      color-mix(in srgb, var(--brand) 8%, transparent) 36%,\n      transparent 68%),\n    linear-gradient(\n      145deg,\n      var(--obsidian) 0%,\n      var(--pitch) 100%);\n  --gradient-feature-signature-atmosphere:\n    linear-gradient(\n      90deg,\n      color-mix(in srgb, var(--accent-strike) 34%, transparent) 0 var(--s2),\n      transparent var(--s2)),\n    linear-gradient(\n      135deg,\n      color-mix(in srgb, var(--t1) 7%, transparent) 0%,\n      transparent 42%),\n    linear-gradient(\n      180deg,\n      transparent 0%,\n      color-mix(in srgb, var(--void) 28%, transparent) 100%);\n  --gradient-feature-signature-highlight:\n    linear-gradient(\n      90deg,\n      transparent,\n      color-mix(in srgb, var(--t1) 38%, transparent),\n      transparent);\n  --gradient-feature-signature-icon: var(--g-strike-edge), var(--g-shine);\n  --feature-signature-border: color-mix(in srgb, var(--brand) 42%, transparent);\n  --feature-signature-icon-border: color-mix(in srgb, var(--t1) 16%, transparent);\n  --feature-signature-depth:\n    0 18px 34px color-mix(in srgb, var(--void) 42%, transparent),\n    0 8px 22px color-mix(in srgb, var(--brand) 16%, transparent),\n    inset 0 1px 0 color-mix(in srgb, var(--t1) 10%, transparent);\n  --feature-signature-depth-active:\n    var(--glow-strike),\n    0 12px 28px color-mix(in srgb, var(--void) 38%, transparent),\n    inset 0 1px 0 color-mix(in srgb, var(--t1) 10%, transparent);\n  --feature-signature-icon-depth: 0 10px 20px color-mix(in srgb, var(--void) 28%, transparent);\n  --gradient-brand-atmosphere:\n    radial-gradient(\n      circle at 80% 0%,\n      var(--brand-glow) 0%,\n      transparent 42%),\n    radial-gradient(\n      circle at 0% 42%,\n      var(--accent-strike-faint) 0%,\n      transparent 34%),\n    linear-gradient(\n      180deg,\n      var(--pitch) 0%,\n      var(--void) 58%,\n      var(--void) 100%);\n  --gradient-brand-primary:\n    linear-gradient(\n      135deg,\n      color-mix(in srgb, var(--brand-deep) 82%, var(--brand)) 0%,\n      var(--brand-deep) 88%,\n      color-mix(in srgb, var(--brand-deep) 72%, var(--accent-strike)) 100%);\n  --gradient-brand-