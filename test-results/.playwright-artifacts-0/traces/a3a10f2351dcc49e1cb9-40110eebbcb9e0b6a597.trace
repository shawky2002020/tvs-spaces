\n      rgba(255, 255, 255, 0.08) 0%,\n      transparent 56%),\n    radial-gradient(\n      ellipse at 100% 100%,\n      rgba(51, 136, 238, 0.40) 0%,\n      transparent 58%),\n    radial-gradient(\n      ellipse at 96% 96%,\n      rgba(231, 76, 60, 0.18) 0%,\n      transparent 38%),\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(255, 255, 255, 0.08) 0%,\n      transparent 42%);\n  --grad-card-athlete:\n    radial-gradient(\n      ellipse at 8% 0%,\n      rgba(255, 255, 255, 0.06) 0%,\n      transparent 36%),\n    radial-gradient(\n      ellipse at 92% 14%,\n      rgba(51, 136, 238, 0.16) 0%,\n      transparent 42%),\n    linear-gradient(\n      145deg,\n      var(--obsidian) 0%,\n      var(--iron) 52%,\n      var(--pitch) 100%);\n  --grad-card-avatar:\n    linear-gradient(\n      145deg,\n      rgba(51, 136, 238, 0.18) 0%,\n      rgba(255, 255, 255, 0.055) 48%,\n      rgba(255, 255, 255, 0.035) 100%),\n    var(--pitch);\n  --grad-card-athlete-rail:\n    linear-gradient(\n      180deg,\n      rgba(255, 255, 255, 0.88) 0%,\n      rgba(51, 136, 238, 0.95) 100%);\n  --grad-profile-canvas:\n    radial-gradient(\n      ellipse at 50% -12%,\n      rgba(51, 136, 238, 0.20) 0%,\n      transparent 46%),\n    linear-gradient(\n      180deg,\n      var(--void) 0%,\n      var(--pitch) 100%);\n  --grad-profile-hero:\n    radial-gradient(\n      ellipse at 15% 0%,\n      rgba(255, 255, 255, 0.10) 0%,\n      transparent 35%),\n    radial-gradient(\n      ellipse at 92% 18%,\n      rgba(51, 136, 238, 0.30) 0%,\n      transparent 48%),\n    linear-gradient(\n      145deg,\n      var(--obsidian) 0%,\n      var(--iron) 54%,\n      var(--pitch) 100%);\n  --grad-profile-panel:\n    radial-gradient(\n      ellipse at 88% 0%,\n      rgba(51, 136, 238, 0.16) 0%,\n      transparent 42%),\n    linear-gradient(\n      145deg,\n      rgba(255, 255, 255, 0.045) 0%,\n      rgba(255, 255, 255, 0.012) 42%,\n      transparent 100%),\n    var(--obsidian);\n  --grad-profile-avatar:\n    radial-gradient(\n      circle at 35% 22%,\n      rgba(255, 255, 255, 0.22) 0%,\n      transparent 28%),\n    linear-gradient(\n      145deg,\n      rgba(51, 136, 238, 0.38) 0%,\n      var(--brand-deep) 54%,\n      var(--pitch) 100%);\n  --grad-profile-stat:\n    linear-gradient(\n      145deg,\n      rgba(255, 255, 255, 0.06) 0%,\n      rgba(51, 136, 238, 0.09) 100%),\n    var(--iron);\n  --btn-feature-primary-bg: var(--gradient-brand-primary);\n  --btn-feature-primary-border: rgba(255, 255, 255, 0.12);\n  --btn-feature-primary-shadow:\n    0 14px 30px rgba(26, 95, 187, 0.30),\n    0 0 18px rgba(51, 136, 238, 0.16),\n    inset 0 1px 0 rgba(255, 255, 255, 0.10);\n  --btn-feature-primary-shadow-active: 0 10px 24px rgba(26, 95, 187, 0.34), var(--glow-brand);\n  --btn-feature-primary-icon-bg:\n    linear-gradient(\n      145deg,\n      rgba(255, 255, 255, 0.20),\n      rgba(255, 255, 255, 0.05));\n  --btn-feature-primary-icon-border: rgba(255, 255, 255, 0.22);\n  --btn-feature-primary-icon-color: #ffffff;\n  --btn-feature-primary-rail: transparent;\n  --btn-feature-match-start-bg: var(--gradient-feature-signature);\n  --btn-feature-match-start-border: var(--feature-signature-border);\n  --btn-feature-match-start-shadow: var(--feature-signature-depth);\n  --btn-feature-match-start-shadow-active: var(--feature-signature-depth-active);\n  --btn-feature-match-start-icon-bg: var(--gradient-feature-signature-icon);\n  --btn-feature-match-start-icon-border: var(--feature-signature-icon-border);\n  --btn-feature-match-start-icon-color: var(--t1);\n  --btn-feature-match-start-rail: var(--accent-strike);\n  --btn-feature-match-next-bg: var(--g-strike-edge);\n  --btn-feature-match-next-border: rgba(51, 136, 238, 0.42);\n  --btn-feature-match-next-shadow: 0 12px 26px rgba(26, 95, 187, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.10);\n  --btn-feature-match-next-shadow-active: 0 10px 28px rgba(51, 136, 238, 0.40), var(--glow-brand);\n  --btn-feature-match-next-icon-bg: var(--g-steel);